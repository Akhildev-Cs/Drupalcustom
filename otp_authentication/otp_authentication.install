<?php

/**
 * @file
 * Install, update and uninstall functions for the OTP authentication module.
 */

/**
 * Implements hook_install().
 */
function otp_authentication_install() {
  \Drupal::messenger()->addStatus(__FUNCTION__);
}

/**
 * Implements hook_uninstall().
 */
function otp_authentication_uninstall() {
  \Drupal::messenger()->addStatus(__FUNCTION__);
}

/**
 * Implements hook_schema().
 */
function otp_authentication_schema() {
  $schema['otp_authentication'] = [
    'description' => 'Table description.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary Key: Unique record ID.',
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The {users}.uid of the user who created the record.',
      ],
      'otp_verified' => [
        'description' => 'Boolean indicating whether this record is active.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'size' => 'tiny',
      ],
      'otp' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Type of the record.',
      ],
      'created' => [
        'type' => 'int',
        // 'not null' => TRUE,
        // 'default' => '',
        'description' => 'Timestamp when the record was created.',
      ],
      'session' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Type of the record.',
      ],
      'no_of_attempts' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'otp created the record.',
      ],
      'expire' => [
        'type' => 'int',
        // 'not null' => TRUE,
        // 'default' => 'CURRENT_TIMESTAMP + INTERVAL 15 MINUTE',
        'description' => 'Timestamp with current time plus 15 minutes.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'id' => ['id'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_requirements().
 */
function otp_authentication_requirements($phase) {
  $requirements = [];

  if ($phase == 'runtime') {
    $value = mt_rand(0, 100);
    $requirements['otp_authentication_status'] = [
      'title' => t('OTP authentication status'),
      'value' => t('OTP authentication value: @value', ['@value' => $value]),
      'severity' => $value > 50 ? REQUIREMENT_INFO : REQUIREMENT_WARNING,
    ];
  }

  return $requirements;
}
